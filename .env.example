# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C0123456789

# LLM providers (at least one required for natural language)
# Anthropic: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Azure OpenAI: portal.azure.com > your OpenAI resource > Keys
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
# Google: aistudio.google.com > API Keys
GOOGLE_API_KEY=

# Vanta (needed for polling — optional if only testing Slack bot)
VANTA_CLIENT_ID=
VANTA_CLIENT_SECRET=

# AWS (needed for remediation — optional if only testing Slack bot)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# PostgreSQL
DATABASE_URL=postgresql://vantaops:vantaops@localhost:5432/vantaops

# Optional: comma-separated Slack user IDs who can approve remediations
# Leave empty to allow anyone (single-user mode)
VANTAOPS_APPROVERS=
